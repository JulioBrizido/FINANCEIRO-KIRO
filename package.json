{
  "name": "financeiro-facil",
  "version": "3.0.0",
  "description": "Sistema de controle financeiro pessoal (web multi-usuário)",
  "main": "main.js",
  "scripts": {
    "web": "node server/index.js",
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist-installer": "electron-builder --win nsis",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.financeiro.facil",
    "productName": "Financeiro Fácil",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "dashboard.html",
      "config.html",
      "db.js",
      "icon.png",
      "icon.ico",
      "css/**/*",
      "js/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Financeiro Fácil"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.1",
    "vitest": "^2.0.0"
  }
}
